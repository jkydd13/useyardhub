# Public browser values. Use the same YardHub Production project as the mobile app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy public-key name is also supported instead of the publishable key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase key. Prefer the newer sb_secret_ key.
# The legacy service_role key is also supported.
# NEVER prefix either server key with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Stripe Sandbox only for this acceptance corridor.
# NEVER prefix these values with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
YARDHUB_COMMERCE_ENVIRONMENT=test

# Local website origin. Change this to https://useyardhub.com in production.
YARDHUB_SITE_URL=http://127.0.0.1:3000
